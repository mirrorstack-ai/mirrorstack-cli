// Package main wires the module runtime. Product declarations live in manifest
// and request behavior lives under internal.
package main

import (
    "embed"
    "log"
    "os"

    ms "github.com/mirrorstack-ai/app-module-sdk"
    "github.com/mirrorstack-ai/app-module-sdk/system"

    "__MS_SLUG__/manifest"
)

//go:embed sql/*
var sqlFS embed.FS

func main() {
    if err := ms.Init(ms.Config{
        ID:   os.Getenv("MS_MODULE_ID"),
        Slug: "__MS_SLUG__",
        Name: "__MS_NAME__",
        Icon: "extension",
        SQL:  sqlFS,
        Versions: map[string]system.MigrationVersions{
            "v0.1.0-dev": {App: "0001"},
        },
    }); err != nil {
        log.Fatalf("mirrorstack: init failed: %v", err)
    }

    manifest.Register()

    if err := ms.Start(); err != nil {
        log.Fatalf("mirrorstack: start failed: %v", err)
    }
}
