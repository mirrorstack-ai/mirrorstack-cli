// Package main is a MirrorStack module.
//
// main.go does four things and then stops growing: read the module's identity,
// load its i18n catalogs, run the two Register() entry points, and start.
// Adding a feature never edits this file — that is what declare/ and
// internal/handlers/ are for. See the SDK's docs/concepts/module-structure.md.
package main

import (
	"embed"
	"log"
	"os"

	ms "github.com/mirrorstack-ai/app-module-sdk"
	"github.com/mirrorstack-ai/app-module-sdk/system"

	"__MS_SLUG__/declare"
	"__MS_SLUG__/internal/handlers"
)

//go:embed sql/*
var sqlFS embed.FS

//go:embed i18n/*.json
var i18nFS embed.FS

func main() {
	if err := ms.Init(ms.Config{
		// ID is the platform-assigned module ID for THIS environment, read
		// from MS_MODULE_ID at runtime (set via ./.env locally, injected as
		// a deploy-time secret in CI/CD). Each environment — local dev, prod
		// — mints its own ID, so it can't live as a literal in this
		// git-committed file; the same source tree runs everywhere.
		ID: os.Getenv("MS_MODULE_ID"),
		// Slug is the catalog handle (e.g. "oauth"). Mutable via catalog UI;
		// the storage prefix at install time is <username>_<slug>_. Renames
		// force a new recorded version with auto-generated rename migrations.
		Slug: "__MS_SLUG__",
		Name: "__MS_NAME__",
		// Description is the short, plain-language summary the catalog and
		// the agent tool listings show. Optional, but an empty one makes the
		// module unfindable in discovery — write it before you publish.
		Description: "Replace this description with your module's purpose.",
		Icon:        "extension",
		SQL:         sqlFS,
		// semver → migration high-water mark, mirroring CHANGELOG.md. The
		// platform reads this to translate an install/upgrade target into the
		// (from, to] migration window it runs. Entries are CUMULATIVE: keep
		// every released version and ADD a new one, never replace. One entry
		// per CHANGELOG version.
		//
		// The `-dev` prerelease tag distinguishes "iterating locally" from
		// "real release". `mirrorstack app module deploy` prompts to promote
		// before shipping; CI (--yes) refuses `-dev` versions.
		Versions: map[string]system.MigrationVersions{
			"v0.1.0-dev": {App: "0001"},
		},
	}); err != nil {
		log.Fatalf("mirrorstack: init failed: %v", err)
	}

	// i18n BEFORE declarations: RegisterPermission resolves ms.T(...) labels
	// against the loaded catalogs, so a declaration that runs first gets an
	// unresolved key. This ordering is the reason declare.Register() is an
	// explicit call and not a pile of init() functions.
	if err := ms.RegisterMessages(i18nFS, "i18n"); err != nil {
		log.Fatalf("mirrorstack: i18n load failed: %v", err)
	}

	// Required deps go here — these become install-time preconditions.
	// Use @<owner>/<slug>@<semver> for the spec; the optional callback
	// declares which relations and events this module reads from the dep.
	//
	//	ms.DependsOn("@anna/oauth@^1.0.0", func(n *ms.Need) {
	//	    n.Table("oauth_users")
	//	    n.Event("user.signed_in")
	//	})

	declare.Register()
	handlers.Register()

	if err := ms.Start(); err != nil {
		log.Fatalf("mirrorstack: start failed: %v", err)
	}
}
